{
    "distro_defaults": {
        "os_versions": 2,
        "packager": "apt"
    },
    "distros": {
        "ubuntu": {
            "dist": "ubuntu",
            "dir": "ubuntu",
            "description": "Ubuntu Linux",
            "human_label": "Ubuntu",
            "has_plesk": true,
            "docker": "ubuntu",
            "packager": "apt",
            "versions_check": false,
            "versions": [
                "20.04",
                "22.04",
                "24.04",
                "26.04"
            ],
            "legacy_versions": [
                "18.04"
            ],
            "codenames_map": {
                "18.04": "bionic",
                "20.04": "focal",
                "22.04": "jammy",
                "24.04": "noble",
                "26.04": "resolute"
            },
            "version_overrides": {
                "2004": {
                    "has_plesk": true
                },
                "2204": {
                    "has_plesk": true
                },
                "2404": {
                    "has_plesk": true
                },
                "2604": {
                    "has_plesk": true
                }
            }
        },
        "debian": {
            "dist": "debian",
            "dir": "debian",
            "description": "Debian Linux",
            "human_label": "Debian",
            "has_plesk": true,
            "docker": "debian",
            "packager": "apt",
            "versions_check": false,
            "versions": [
                12,
                13
            ],
            "legacy_versions": [
                10
            ],
            "codenames_map": {
                "10": "buster",
                "12": "bookworm",
                "13": "trixie"
            },
            "version_overrides": {
                "12": {
                    "has_plesk": true
                },
                "13": {
                    "has_plesk": true
                }
            }
        }
    },
    "collections": {
        "nginx": {
            "custom_steps_after_checkout": [
                {
                    "run": {
                        "name": "Set up DEB macro reflecting the NGINX branch",
                        "command": "echo \"nginx_branch=${CIRCLE_BRANCH}\" >> debmacros\n"
                    }
                },
                {
                    "run": {
                        "name": "Set up plesk macro if passed by a job",
                        "command": "if [[ \"${PLESK:-0}\" != \"0\" ]]; then\n  echo \"plesk_version=${PLESK}\" >> debmacros\nfi\n"
                    }
                }
            ],
            "branches": {
                "stable": {
                    "description": "Stable NGINX",
                    "git_branch": "master"
                },
                "mainline": {
                    "description": "Mainline NGINX",
                    "enable_repos": "getpagespeed-extras-mainline"
                },
                "angie": {
                    "description": "Angie"
                },
                "nginx-mod": {
                    "description": "NGINX-MOD"
                },
                "tengine": {
                    "description": "Tengine"
                },
                "plesk": {
                    "description": "Plesk",
                    "plesk_version": 18,
                    "only_dists": [
                        "ubuntu*",
                        "debian*"
                    ],
                    "only_archs": [
                        "amd64"
                    ]
                },
                "freenginx-mainline": {
                    "description": "FreeNGINX Mainline"
                }
            }
        },
        "varnish": {
            "branches": {
                "varnish60": {
                    "description": "Varnish 6.0 LTS"
                }
            }
        }
    }
}